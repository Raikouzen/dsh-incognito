{
  "name": "dsh-incognito",
  "version": "0.1.0",
  "description": "Incognito sessions for DeepSeek Harness: an independent temporary agent in a floating window, destroyed when the window closes.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "docs/",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "incognito",
    "privacy",
    "ephemeral"
  ],
  "license": "MIT",
  "author": "Raikouzen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raikouzen/dsh-incognito.git"
  },
  "homepage": "https://github.com/Raikouzen/dsh-incognito#readme",
  "bugs": {
    "url": "https://github.com/Raikouzen/dsh-incognito/issues"
  }
}
